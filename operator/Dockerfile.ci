# OpenShift CI build variant (Prow / ci-operator). Base images come from
# registry.ci.openshift.org instead of registry.access.redhat.com, so the build
# runs inside the OpenShift CI cluster once the repo is onboarded to
# openshift/release. Build steps mirror the release Dockerfile; only the FROM
# lines differ. The builder/base tags must track the target OCP release and are
# finalized in the openshift/release ci-operator config (see .ci-operator.yaml).
FROM registry.ci.openshift.org/ocp/builder:rhel-9-golang-1.26-openshift-4.22 AS build
ARG SOURCE_DATE_EPOCH=0
ENV GOTOOLCHAIN=go1.26.6
# Match the release Dockerfile's reproducibility knobs (only the FROM lines and
# CI-owned promotion differ): pinned epoch, checksum DB on, readonly modules.
ENV TZ=UTC LC_ALL=C SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} GOSUMDB=sum.golang.org GOFLAGS=-mod=readonly
WORKDIR /go/src/github.com/maci0/baseline-security-operator
COPY go.mod go.sum ./
RUN go mod download && go mod verify
COPY api/ api/
COPY cmd/ cmd/
COPY internal/ internal/
# Hermetic compile: GOPROXY=off plus --network=none so the build cannot reach the
# network after deps are downloaded/verified above, matching the release
# Dockerfile. Keeps the CI image bit-comparable and closes a supply-chain seam.
ENV GOPROXY=off
RUN --network=none CGO_ENABLED=0 go build -trimpath -buildvcs=false -mod=readonly -buildmode=pie -ldflags="-s -w -buildid=" -o /tmp/manager ./cmd \
	&& test -s /tmp/manager

FROM registry.ci.openshift.org/ocp/4.22:base-rhel9
# BuildKit special-case ARG: must be declared in this stage too or layer
# timestamps are not clamped (release Dockerfile already does this).
ARG SOURCE_DATE_EPOCH=0
ARG VERSION=0.6.1
COPY --from=build --chown=65532:65532 --chmod=0755 /tmp/manager /usr/bin/manager
# Two COPYs on purpose: --chmod also stamps the parent dir BuildKit creates,
# so a single 0644 copy leaves /licenses non-traversable for the non-root USER.
# Both modes are explicit so a host umask cannot move the layer digest.
COPY --chmod=0755 LICENSE /licenses/
COPY --chmod=0644 LICENSE /licenses/LICENSE
LABEL org.opencontainers.image.title="Baseline Security Operator"
LABEL org.opencontainers.image.description="Cluster-scoped OpenShift compliance baseline operator."
LABEL org.opencontainers.image.source="https://github.com/maci0/openshift-baseline-security"
LABEL org.opencontainers.image.licenses="Apache-2.0"
LABEL org.opencontainers.image.version="${VERSION}"
USER 65532:65532
ENTRYPOINT ["/usr/bin/manager"]
