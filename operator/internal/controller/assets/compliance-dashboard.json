{
  "title": "Baseline Security / Compliance",
  "uid": "baseline-security-compliance",
  "schemaVersion": 17,
  "editable": true,
  "tags": ["compliance", "baseline-security"],
  "time": { "from": "now-30d", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "rows": [
    {
      "title": "Score",
      "showTitle": false,
      "height": "150px",
      "panels": [
        {
          "id": 1,
          "title": "Compliance score",
          "type": "singlestat",
          "datasource": "$datasource",
          "span": 3,
          "format": "none",
          "valueName": "current",
          "thresholds": "60,90",
          "colorValue": true,
          "colors": ["#b1380b", "#dca614", "#3d7317"],
          "targets": [
            { "expr": "max((baseline_security_compliance_score >= 0) and on(instance) topk(1, baseline_security_status_observed_timestamp_seconds))", "refId": "A" }
          ]
        },
        {
          "id": 5,
          "title": "Degraded",
          "type": "singlestat",
          "datasource": "$datasource",
          "span": 3,
          "format": "none",
          "valueName": "current",
          "thresholds": "0.5,0.5",
          "colorValue": true,
          "colors": ["#3d7317", "#b1380b", "#b1380b"],
          "targets": [
            { "expr": "max(baseline_security_condition{type=\"Degraded\"} and on(instance) topk(1, baseline_security_status_observed_timestamp_seconds))", "refId": "A" }
          ]
        },
        {
          "id": 6,
          "title": "Remediation batch active",
          "type": "singlestat",
          "datasource": "$datasource",
          "span": 2,
          "format": "none",
          "valueName": "current",
          "thresholds": "0.5,0.5",
          "colorValue": true,
          "colors": ["#3d7317", "#dca614", "#b1380b"],
          "targets": [
            { "expr": "max(baseline_security_remediation_batch_active and on(instance) topk(1, baseline_security_status_observed_timestamp_seconds))", "refId": "A" }
          ]
        },
        {
          "id": 11,
          "title": "Batch age (paused MCPs)",
          "type": "singlestat",
          "datasource": "$datasource",
          "span": 2,
          "format": "s",
          "valueName": "current",
          "thresholds": "600,1200",
          "colorValue": true,
          "colors": ["#3d7317", "#dca614", "#b1380b"],
          "targets": [
            { "expr": "(max(baseline_security_remediation_batch_active and on(instance) topk(1, baseline_security_status_observed_timestamp_seconds)) == 1) * (time() - max((baseline_security_remediation_batch_started_timestamp_seconds > 0) and on(instance) topk(1, baseline_security_status_observed_timestamp_seconds))) or vector(0)", "refId": "A" }
          ]
        },
        {
          "id": 16,
          "title": "Batches unpaused early (24h)",
          "type": "singlestat",
          "datasource": "$datasource",
          "span": 2,
          "format": "none",
          "valueName": "current",
          "thresholds": "0.5,0.5",
          "colorValue": true,
          "colors": ["#3d7317", "#b1380b", "#b1380b"],
          "targets": [
            { "expr": "sum(increase(baseline_security_remediation_batches_total{outcome=~\"grace|orphaned\"}[24h])) or vector(0)", "refId": "A" }
          ]
        }
      ]
    },
    {
      "title": "Score trend",
      "showTitle": false,
      "height": "250px",
      "panels": [
        {
          "id": 2,
          "title": "Compliance score (30d)",
          "type": "graph",
          "datasource": "$datasource",
          "span": 12,
          "yaxes": [ { "format": "none", "min": 0, "max": 100 }, { "show": false } ],
          "thresholds": "60,90",
          "colorValue": true,
          "colors": ["#b1380b", "#dca614", "#3d7317"],
          "targets": [
            { "expr": "max((baseline_security_compliance_score >= 0) and on(instance) topk(1, baseline_security_status_observed_timestamp_seconds))", "legendFormat": "score", "refId": "A" }
          ]
        }
      ]
    },
    {
      "title": "Checks by status",
      "showTitle": false,
      "height": "250px",
      "panels": [
        {
          "id": 3,
          "title": "Checks by status",
          "type": "graph",
          "datasource": "$datasource",
          "span": 6,
          "stack": true,
          "colors": ["#fbbea8", "#b1380b", "#147878", "#5e40be", "#dca614", "#a3a3a3", "#3d7317", "#a3a3a3"],
          "seriesOverrides": [
            { "match": "^pass$", "colors": ["#3d7317"] },
            { "match": "^fail$", "colors": ["#b1380b"] },
            { "match": "^error$", "colors": ["#fbbea8"] },
            { "match": "^manual$", "colors": ["#dca614"] },
            { "match": "^info$", "colors": ["#5e40be"] },
            { "match": "^inconsistent$", "colors": ["#147878"] },
            { "match": "^(waived|notApplicable)$", "colors": ["#a3a3a3"] }
          ],
          "targets": [
            { "expr": "sum by (status) (baseline_security_checks and on(instance) topk(1, baseline_security_status_observed_timestamp_seconds))", "legendFormat": "{{status}}", "refId": "A" }
          ]
        },
        {
          "id": 4,
          "title": "Failing checks by profile",
          "type": "graph",
          "datasource": "$datasource",
          "span": 6,
          "colors": ["#b1380b"],
          "targets": [
            { "expr": "sum by (profile) (baseline_security_checks{status=\"fail\"} and on(instance) topk(1, baseline_security_status_observed_timestamp_seconds))", "legendFormat": "{{profile}}", "refId": "A" }
          ]
        }
      ]
    },
    {
      "title": "Operator health",
      "showTitle": false,
      "height": "200px",
      "panels": [
        {
          "id": 7,
          "title": "Rollup conditions",
          "type": "graph",
          "datasource": "$datasource",
          "span": 2,
          "yaxes": [ { "format": "none", "min": 0, "max": 1 }, { "show": false } ],
          "colors": ["#a3a3a3", "#5e40be", "#b1380b", "#a3a3a3", "#a3a3a3", "#a3a3a3", "#a3a3a3"],
          "seriesOverrides": [
            { "match": "^Available$", "colors": ["#3d7317"] },
            { "match": "^Progressing$", "colors": ["#5e40be"] },
            { "match": "^Degraded$", "colors": ["#b1380b"] },
            { "match": "^(ComplianceOperatorReady|ScanConfigured|ScanStorageReady|ConsolePluginReady)$", "colors": ["#a3a3a3"] }
          ],
          "targets": [
            { "expr": "max by (type) (baseline_security_condition and on(instance) topk(1, baseline_security_status_observed_timestamp_seconds))", "legendFormat": "{{type}}", "refId": "A" }
          ]
        },
        {
          "id": 8,
          "title": "Metrics freshness (seconds since publish)",
          "type": "graph",
          "datasource": "$datasource",
          "span": 2,
          "yaxes": [ { "format": "s", "min": 0 }, { "show": false } ],
          "colors": ["#a3a3a3"],
          "targets": [
            { "expr": "time() - max(baseline_security_status_observed_timestamp_seconds)", "legendFormat": "publish age", "refId": "A" }
          ]
        },
        {
          "id": 9,
          "title": "Last scan age",
          "type": "graph",
          "datasource": "$datasource",
          "span": 2,
          "yaxes": [ { "format": "s", "min": 0 }, { "show": false } ],
          "colors": ["#a3a3a3"],
          "targets": [
            { "expr": "time() - max((baseline_security_last_scan_timestamp_seconds > 0) and on(instance) topk(1, baseline_security_status_observed_timestamp_seconds))", "legendFormat": "scan age", "refId": "A" }
          ]
        },
        {
          "id": 10,
          "title": "Newly failed (regressions)",
          "type": "graph",
          "datasource": "$datasource",
          "span": 2,
          "yaxes": [ { "format": "none", "min": 0 }, { "show": false } ],
          "colors": ["#b1380b"],
          "targets": [
            { "expr": "max(baseline_security_newly_failed and on(instance) topk(1, baseline_security_status_observed_timestamp_seconds))", "legendFormat": "newly failed", "refId": "A" }
          ]
        },
        {
          "id": 12,
          "title": "Error checks",
          "type": "singlestat",
          "datasource": "$datasource",
          "span": 2,
          "format": "none",
          "valueName": "current",
          "thresholds": "0.5,1",
          "colorValue": true,
          "colors": ["#3d7317", "#dca614", "#b1380b"],
          "targets": [
            { "expr": "sum(baseline_security_checks{status=\"error\"} and on(instance) topk(1, baseline_security_status_observed_timestamp_seconds)) or vector(0)", "refId": "A" }
          ]
        },
        {
          "id": 13,
          "title": "Inconsistent checks",
          "type": "singlestat",
          "datasource": "$datasource",
          "span": 2,
          "format": "none",
          "valueName": "current",
          "thresholds": "0.5,1",
          "colorValue": true,
          "colors": ["#3d7317", "#dca614", "#b1380b"],
          "targets": [
            { "expr": "sum(baseline_security_checks{status=\"inconsistent\"} and on(instance) topk(1, baseline_security_status_observed_timestamp_seconds)) or vector(0)", "refId": "A" }
          ]
        }
      ]
    },
    {
      "title": "Reconcile loop",
      "showTitle": false,
      "height": "200px",
      "panels": [
        {
          "id": 14,
          "title": "Reconcile errors",
          "type": "graph",
          "datasource": "$datasource",
          "span": 6,
          "yaxes": [ { "format": "ops", "min": 0 }, { "show": false } ],
          "colors": ["#b1380b", "#5e40be"],
          "seriesOverrides": [
            { "match": "^errors$", "colors": ["#b1380b"] },
            { "match": "^reconciles$", "colors": ["#5e40be"] }
          ],
          "targets": [
            {
              "expr": "sum(rate(controller_runtime_reconcile_errors_total[15m]))",
              "legendFormat": "errors",
              "refId": "A"
            },
            {
              "expr": "sum(rate(controller_runtime_reconcile_total[15m]))",
              "legendFormat": "reconciles",
              "refId": "B"
            }
          ]
        },
        {
          "id": 15,
          "title": "Reconcile duration",
          "type": "graph",
          "datasource": "$datasource",
          "span": 6,
          "yaxes": [ { "format": "s", "min": 0 }, { "show": false } ],
          "colors": ["#5e40be", "#147878"],
          "targets": [
            {
              "expr": "histogram_quantile(0.99, sum by (le) (rate(controller_runtime_reconcile_time_seconds_bucket[10m])))",
              "legendFormat": "p99",
              "refId": "A"
            },
            {
              "expr": "histogram_quantile(0.50, sum by (le) (rate(controller_runtime_reconcile_time_seconds_bucket[10m])))",
              "legendFormat": "p50",
              "refId": "B"
            }
          ]
        }
      ]
    }
  ]
}
