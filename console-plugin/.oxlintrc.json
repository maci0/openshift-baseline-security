{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"options": {
		"typeAware": true
	},
	"plugins": ["typescript", "unicorn", "oxc", "react", "vitest", "jsdoc", "jest"],
	"categories": {
		"perf": "error"
	},
	"extends": [
		"./node_modules/@rikalabs/oxlint-standards/presets/strict-tests-jest.json"
	],
	"jsPlugins": [
		"@rikalabs/oxlint-standards/plugin",
		{ "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" }
	],
	"ignorePatterns": [
		"dist/**",
		"coverage/**",
		"test-results/**",
		"node_modules/**",
		"tools/oxlint/anti-slop/**"
	],
	// This repo tests with jest, and `strict-tests-jest.json` selects that
	// variant, but the preset extends `strict-tests.json`, which enables the
	// vitest rules, and never turns them off. Three of them cannot be satisfied:
	// `prefer-to-be-truthy` / `prefer-to-be-falsy` rewrite assertions the tests
	// deliberately write exactly (`toBe(true)` / `toBe(false)`), and a
	// `toBeTruthy()` passes on any truthy value, so complying would weaken 38
	// assertions rather than enforce anything; `prefer-called-once` and
	// `prefer-called-times` flag each other's spelling of the same strict claim,
	// and the tests use the `toHaveBeenCalledTimes(1)` form. The rest of the
	// namespace stays on: it finds nothing in this tree. Drop this block if the
	// repo ever runs vitest.
	"rules": {
		"vitest/prefer-called-once": "off",
		"vitest/prefer-to-be-falsy": "off",
		"vitest/prefer-to-be-truthy": "off",
		"anti-slop/no-chained-type-assertions": "error",
		"anti-slop/no-conditional-empty-object-spread": "error",
		"anti-slop/no-known-value-widening": "error",
		"anti-slop/no-module-mocking": "error",
		"anti-slop/no-object-parameters": "error",
		"anti-slop/no-reflect-apply": "error",
		"anti-slop/no-reflect-get": "error",
		"anti-slop/no-runtime-typeof": [
			"error",
			{ "allowInTypeGuards": true }
		],
		"anti-slop/no-shape-in-symbol-names": "error",
		"anti-slop/no-unknown-parameters": [
			"error",
			{ "allowInTypeGuards": true }
		],
		"anti-slop/no-unknown-returns": "error",
		"anti-slop/no-unknown-type-aliases": "error",
		"anti-slop/no-unsafe-dictionary-type": "error",
		"anti-slop/no-widen-then-assert": "error",
		"anti-slop/require-safety-comment-for-type-assertion": "error"
	},
	"overrides": [
		{
			"files": ["e2e/**"],
			"rules": {
				"vitest/consistent-test-filename": "off"
			}
		}
	]
}
