{
  "name": "baseline-security-console-plugin",
  "version": "0.9.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run typecheck && bun run clean && NODE_ENV=production TZ=UTC LC_ALL=C SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH:-0} webpack && bun run licenses && bun run size && test -s dist/plugin-manifest.json && test -s dist/locales/en/plugin__baseline-security-console-plugin.json && test -s dist/THIRD-PARTY-NOTICES.txt && ls dist/plugin-entry*.min.js >/dev/null",
    "licenses": "bun tools/attribution/generate.ts",
    "size": "bun tools/size/check.ts",
    "start": "NODE_ENV=development webpack serve",
    "lint": "eslint ./src ./e2e ./tools/attribution ./tools/size webpack.config.ts --max-warnings=0",
    "lint:oxlint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test-e2e": "playwright test -c e2e/playwright.config.ts",
    "ci": "bun run lint && bun run lint:oxlint && bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@openshift-console/dynamic-plugin-sdk": "4.22.0",
    "@openshift-console/dynamic-plugin-sdk-webpack": "4.22.0",
    "@oxlint/plugins": "1.81.0",
    "@patternfly/react-charts": "^8.6.0",
    "@patternfly/react-core": "^6.4.3",
    "@patternfly/react-icons": "^6.6.1",
    "@patternfly/react-table": "^6.4.3",
    "@playwright/test": "^1.62.1",
    "@rikalabs/oxlint-standards": "0.8.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.28",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "i18next": "~26.4.2",
    "jest": "^30.4.2",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "~16.5.8",
    "react-router": "~7.13.1",
    "ts-jest": "^29.4.13",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.69.0",
    "victory-area": "37.3.6",
    "victory-axis": "37.3.6",
    "victory-bar": "37.3.6",
    "victory-box-plot": "37.3.6",
    "victory-chart": "37.3.6",
    "victory-core": "37.3.6",
    "victory-create-container": "37.3.6",
    "victory-cursor-container": "37.3.6",
    "victory-group": "37.3.6",
    "victory-legend": "37.3.6",
    "victory-line": "37.3.6",
    "victory-pie": "37.3.6",
    "victory-scatter": "37.3.6",
    "victory-stack": "37.3.6",
    "victory-tooltip": "37.3.6",
    "victory-voronoi-container": "37.3.6",
    "victory-zoom-container": "37.3.6",
    "webpack": "^5.110.1",
    "webpack-cli": "7.2.1",
    "webpack-dev-server": "^6.0.0"
  },
  "consolePlugin": {
    "name": "baseline-security-console-plugin",
    "version": "0.9.0",
    "displayName": "Baseline Security",
    "description": "Cluster compliance baseline dashboard driven by the Compliance Operator.",
    "exposedModules": {
      "CompliancePage": "./components/CompliancePage",
      "ClusterScoreItem": "./components/ClusterScoreItem"
    },
    "dependencies": {
      "@console/pluginAPI": ">=4.22.0-0 <4.23.0-0"
    }
  },
  "resolutions": {
    "glob": "^13.0.6",
    "test-exclude": "^8.0.0",
    "uuid": "^11.1.1",
    "fast-uri": "^3.1.5",
    "brace-expansion": "^5.0.8",
    "tar": "^7.5.21",
    "js-yaml": "^3.15.2",
    "qs": "^6.16.0",
    "undici": "^8.9.0"
  },
  "trustedDependencies": [],
  "packageManager": "bun@1.4.2"
}
