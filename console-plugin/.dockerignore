node_modules/
dist/
coverage/
.yarn/
e2e/
test-results/
playwright-report/
blob-report/
**/*.test.ts
**/*.test.tsx
jest.config.cjs
eslint.config.mjs
*.log
*.md
.dockerignore
# Secrets and local env must never enter the build context.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*kubeconfig*
id_rsa*
id_ed25519*
.git
.gitignore
*.tsbuildinfo
# Toolchain pins and local IDE state are not webpack inputs.
.nvmrc
.vscode/
.idea/
# Not required by the webpack build stage (nginx.conf is copied in the final stage).
Dockerfile
Makefile
.oxlintrc.json
tools/*
# ...except the attribution generator: `yarn build` runs it to emit
# dist/THIRD-PARTY-NOTICES.txt, so the build stage needs its sources.
# (`tools/*` rather than `tools/`: a negated child cannot re-include a file
# whose parent directory the ignore list already excluded.)
!tools/attribution/
src/testing/
