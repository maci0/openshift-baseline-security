node_modules/
dist/
coverage/
.yarn/
e2e/
test-results/
playwright-report/
blob-report/
**/*.test.ts
**/*.test.tsx
jest.config.cjs
eslint.config.mjs
*.log
*.md
.dockerignore
# Secrets and local env must never enter the build context.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*kubeconfig*
id_rsa*
id_ed25519*
.git
.gitignore
*.tsbuildinfo
# Toolchain pins and local IDE state are not webpack inputs.
.nvmrc
.vscode/
.idea/
# Not required by the webpack build stage (nginx.conf is copied in the final stage).
Dockerfile
Makefile
.oxlintrc.json
tools/*
# ...except the tools `yarn build` runs: the attribution generator emits
# dist/THIRD-PARTY-NOTICES.txt and the size gate reads dist/ and fails the build
# on a budget breach. `tools/oxlint` stays out (lint only, never in the image).
# (`tools/*` rather than `tools/`: a negated child cannot re-include a file
# whose parent directory the ignore list already excluded.)
!tools/attribution/
!tools/size/
# The negations above re-include everything under those directories, undoing the
# `**/*.test.ts` rule; re-exclude the test so only build inputs travel.
tools/attribution/*.test.ts
src/testing/
tools/size/*.test.ts
